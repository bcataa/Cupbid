# Frontend (Vite — safe to expose in browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# ---------------------------------------------------------------------------
# Supabase SQL (run all migrations 001–005 in SQL Editor, in order)
# ---------------------------------------------------------------------------

# Before accepting real money, disable free test bids:
#   update site_metrics set free_bids_enabled = false where id = 'global';

# To edit a listing pitch (users cannot change pitch on raise):
#   update listings set tagline = 'Your new pitch' where website_key = 'example.com';

# ---------------------------------------------------------------------------
# Edge Function secrets (Supabase Dashboard → Edge Functions → Secrets)
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# STRIPE_SECRET_KEY=sk_live_...   (or sk_test_... for testing)
# STRIPE_WEBHOOK_SECRET=whsec_...
# SITE_URL=https://cupbid.lol

# ---------------------------------------------------------------------------
# Deploy edge functions (from project root, with Supabase CLI logged in)
# ---------------------------------------------------------------------------
# supabase functions deploy create-bid-checkout
# supabase functions deploy stripe-webhook

# ---------------------------------------------------------------------------
# Stripe webhook
# ---------------------------------------------------------------------------
# In Stripe Dashboard → Developers → Webhooks, add endpoint:
#   https://YOUR_PROJECT.supabase.co/functions/v1/stripe-webhook
# Event: checkout.session.completed

# ---------------------------------------------------------------------------
# Railway (frontend)
# ---------------------------------------------------------------------------
# VITE_SUPABASE_URL
# VITE_SUPABASE_ANON_KEY
